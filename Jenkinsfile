pipeline {
    agent any

    stages {
        stage('Clone') {
            steps {
                echo 'Cloning done by Jenkins automatically'
            }
        }

        stage('Build') {
            steps {
                echo 'Pretend to build (no real mvn command)'
            }
        }

        stage('Test') {
            steps {
                echo 'Pretend to run tests (no real test command)'
            }
        }
    }
}
